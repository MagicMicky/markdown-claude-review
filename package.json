{
  "name": "markdown-claude-review",
  "displayName": "Markdown Claude Review",
  "description": "Google-Docs-style comment threads on markdown, wired back to Claude Code over MCP.",
  "version": "0.1.0",
  "publisher": "magicmicky",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MagicMicky/markdown-claude-review.git"
  },
  "bugs": {
    "url": "https://github.com/MagicMicky/markdown-claude-review/issues"
  },
  "homepage": "https://github.com/MagicMicky/markdown-claude-review#readme",
  "keywords": [
    "markdown",
    "review",
    "comments",
    "annotations",
    "claude",
    "claude-code",
    "mcp",
    "documentation"
  ],
  "private": true,
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=18"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "markdown-review-mcp": "./dist/mcp.js"
  },
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mdreview.createThread",
        "title": "Add Comment",
        "category": "Markdown Review"
      },
      {
        "command": "mdreview.replyThread",
        "title": "Reply",
        "category": "Markdown Review"
      },
      {
        "command": "mdreview.commentOnSelection",
        "title": "Add Comment on Selection",
        "category": "Markdown Review",
        "icon": "$(comment-add)"
      },
      {
        "command": "mdreview.openPreviewToSide",
        "title": "Open Review Preview to the Side",
        "category": "Markdown Review",
        "icon": "$(open-preview)"
      },
      {
        "command": "mdreview.openPreview",
        "title": "Open Review Preview",
        "category": "Markdown Review",
        "icon": "$(preview)"
      },
      {
        "command": "mdreview.resolveThread",
        "title": "Resolve Thread",
        "category": "Markdown Review",
        "icon": "$(check)"
      },
      {
        "command": "mdreview.unresolveThread",
        "title": "Reopen Thread",
        "category": "Markdown Review",
        "icon": "$(history)"
      },
      {
        "command": "mdreview.deleteThread",
        "title": "Delete Thread",
        "category": "Markdown Review",
        "icon": "$(trash)"
      },
      {
        "command": "mdreview.reattachThread",
        "title": "Re-attach Stale Thread to Selection",
        "category": "Markdown Review",
        "icon": "$(link)"
      },
      {
        "command": "mdreview.revealThread",
        "title": "Go to Thread",
        "category": "Markdown Review"
      },
      {
        "command": "mdreview.nextThread",
        "title": "Next Comment",
        "category": "Markdown Review",
        "icon": "$(arrow-down)"
      },
      {
        "command": "mdreview.previousThread",
        "title": "Previous Comment",
        "category": "Markdown Review",
        "icon": "$(arrow-up)"
      },
      {
        "command": "mdreview.toggleInlineThreads",
        "title": "Toggle Inline Comment Threads",
        "category": "Markdown Review"
      },
      {
        "command": "mdreview.sendToClaude",
        "title": "Send Review to Claude Code",
        "category": "Markdown Review",
        "icon": "$(send)"
      },
      {
        "command": "mdreview.setupClaude",
        "title": "Set Up Claude Code Integration",
        "category": "Markdown Review"
      },
      {
        "command": "mdreview.refresh",
        "title": "Refresh Threads",
        "category": "Markdown Review",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "mdreview.replyThread",
          "when": "false"
        },
        {
          "command": "mdreview.resolveThread",
          "when": "false"
        },
        {
          "command": "mdreview.unresolveThread",
          "when": "false"
        },
        {
          "command": "mdreview.deleteThread",
          "when": "false"
        },
        {
          "command": "mdreview.revealThread",
          "when": "false"
        },
        {
          "command": "mdreview.createThread",
          "when": "false"
        },
        {
          "command": "mdreview.reattachThread",
          "when": "false"
        },
        {
          "command": "mdreview.commentOnSelection",
          "when": "editorLangId == markdown"
        },
        {
          "command": "mdreview.nextThread",
          "when": "editorLangId == markdown"
        },
        {
          "command": "mdreview.previousThread",
          "when": "editorLangId == markdown"
        },
        {
          "command": "mdreview.openPreview",
          "when": "editorLangId == markdown"
        },
        {
          "command": "mdreview.openPreviewToSide",
          "when": "editorLangId == markdown"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "mdreview.createThread",
          "group": "inline@1",
          "when": "commentController == mdreview && commentThreadIsEmpty"
        },
        {
          "command": "mdreview.replyThread",
          "group": "inline@1",
          "when": "commentController == mdreview && !commentThreadIsEmpty"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "mdreview.resolveThread",
          "group": "navigation@1",
          "when": "commentController == mdreview && commentThread =~ /open|answered|stale/"
        },
        {
          "command": "mdreview.unresolveThread",
          "group": "navigation@2",
          "when": "commentController == mdreview && commentThread =~ /resolved/"
        },
        {
          "command": "mdreview.deleteThread",
          "group": "navigation@3",
          "when": "commentController == mdreview"
        }
      ],
      "editor/context": [
        {
          "command": "mdreview.commentOnSelection",
          "group": "1_modification@1",
          "when": "editorLangId == markdown"
        }
      ],
      "editor/title": [
        {
          "command": "mdreview.openPreviewToSide",
          "group": "navigation",
          "when": "editorLangId == markdown"
        }
      ]
    },
    "configuration": {
      "title": "Markdown Claude Review",
      "properties": {
        "mdreview.reviewDir": {
          "type": "string",
          "default": ".review",
          "description": "Directory (relative to the workspace root) where comment threads and review requests are stored.",
          "scope": "machine"
        },
        "mdreview.author": {
          "type": "string",
          "default": "",
          "description": "Name recorded as the author of your comments. Defaults to your git user.name, else 'You'.",
          "scope": "machine"
        },
        "mdreview.terminalName": {
          "type": "string",
          "default": "claude",
          "description": "Substring used to find the Claude Code terminal when sending a review.",
          "scope": "machine"
        },
        "mdreview.highlightCommentedRanges": {
          "type": "boolean",
          "default": true,
          "description": "Underline commented passages in the editor, and highlight the one the cursor is in."
        },
        "mdreview.fuzzyThreshold": {
          "type": "number",
          "default": 0.62,
          "description": "Similarity (0-1) required to re-attach a comment to a rewritten paragraph. Below this the thread is marked stale instead."
        },
        "mdreview.sendPrompt": {
          "type": "string",
          "default": "/review",
          "description": "What the Send Review command types into the Claude Code terminal. Claude reads the comments over MCP, so this is just a trigger.",
          "scope": "machine",
          "markdownDescription": "What the Send Review command types into the Claude Code terminal. Claude reads the comments over MCP, so this is just a trigger. Machine-scoped: it is typed into a terminal, so a workspace must not be able to set it."
        },
        "mdreview.inlineThreads": {
          "type": "string",
          "enum": [
            "collapsed",
            "expanded",
            "off"
          ],
          "default": "collapsed",
          "enumDescriptions": [
            "A gutter marker and an underline. Never displaces prose; click the marker to open a thread in place.",
            "Threads open inline, pushing the surrounding text down.",
            "No inline threads at all. The Comments sidebar is the only surface."
          ],
          "description": "How comment threads appear in the editor itself. The Comments sidebar is unaffected."
        }
      }
    },
    "keybindings": [
      {
        "command": "mdreview.commentOnSelection",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "mdreview.openPreviewToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == markdown"
      },
      {
        "command": "mdreview.openPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorLangId == markdown"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.webview.json",
    "test": "node --test dist-test/test/*.test.js",
    "pretest": "tsc -p tsconfig.test.json",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies -o markdown-claude-review.vsix"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^12.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/markdown-it": "^12.2.3",
    "@types/node": "^22.9.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Comment threads are read from files in the workspace, and the review hand-off types a configurable line into a terminal."
    }
  }
}
